{
  "name": "quickdesk-webclient",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-legacy.js",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "test:e2e:reconnect": "node --test test/e2e/reconnect.e2e.mjs",
    "test:e2e:file-manager": "node --test test/e2e/file-manager.e2e.mjs",
    "test:e2e:tab-coordinator": "node --test test/e2e/tab-coordinator.e2e.mjs",
    "test:e2e:wall": "node --test test/e2e/wall.e2e.mjs",
    "test:e2e:devices": "node --test test/e2e/devices.e2e.mjs",
    "test:e2e:selfhost": "npm run build && node --test test/e2e/selfhost.e2e.mjs",
    "test:e2e:wall-soak": "node --test test/e2e/wall-soak.e2e.mjs",
    "test:e2e:control-mode": "node --test test/e2e/control-mode.e2e.mjs",
    "test:e2e:control-grant": "node --test test/e2e/control-grant.e2e.mjs"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-i18n": "^9.13.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@noble/curves": "1.8.1",
    "@noble/hashes": "1.7.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "playwright": "^1.64.1",
    "vite": "^5.0.0"
  }
}
